  m_Script: {fileID: 11500000, guid: c8aacd0e4b30b5d46a727666d017bf22, type: 3}
  m_Name: NPC_Leandre_Phase1
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Léandre
    text: "Pff... encore une journ\xE9e \xE0 ne rien faire sur cette plateforme."
  - speakerName: Lucian
    text: "Tu gardes espoir, L\xE9andre?"
  - speakerName: Léandre
    text: "J'en sais rien. Je ne me souviens m\xEAme pas d'o\xF9 je viens."
  - speakerName: Léandre
    text: "Si quelqu'un peut nous sortir d'ici, c'est toi."
  - speakerName: Léandre
    text: "Alors... tu vas trouver un moyen, hein?"
  - speakerName: Lucian
    text: "Je ferai tout pour nous lib\xE9rer."
  - speakerName: Léandre
    text: "Je compte sur toi. Moi, je suis trop fatigu\xE9 pour y croire."
  randomPosition: 1
  customPosition: {x: 0, y: 0, z: 0}
